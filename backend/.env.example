# Backend environment. Copy to .env and fill in the values.
# Variables marked (required) stop the server at startup when missing
# (src/config/env.js). Never commit the real .env.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # production on the server (required there)
PORT=5003                            # production: 5002, must match nginx
FRONTEND_URL=http://localhost:5173   # (required in production) only origin allowed by CORS
CORS_ORIGINS=                        # optional extra allowed origins, comma separated
LOG_LEVEL=                           # DEBUG | INFO | WARN | ERROR
CRON_TZ=                             # time zone for scheduled jobs, e.g. Asia/Kolkata (default: server time)
SHUTDOWN_TIMEOUT_MS=15000            # graceful shutdown limit; keep below PM2 kill_timeout (20000)
SHUTDOWN_HOOK_TIMEOUT_MS=
API_LOG_RETENTION_DAYS=90            # sys_api_logs rows older than this are deleted nightly

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=                          # (required) long random string
JWT_REFRESH_SECRET=                  # (required) different long random string
JWT_RESET_SECRET=                    # optional; derived from JWT_SECRET when empty
ENABLE_CAPTCHA=true                  # false disables the login CAPTCHA
RECAPTCHA_SECRET_KEY=

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=127.0.0.1                    # (required)
DB_PORT=3306
ATTENDANCE_DB_USER=                  # (required) application user
ATTENDANCE_DB_PASSWORD=              # (required)
ATTENDANCE_DB_NAME=                  # (required)
# User with ALTER rights for `npm run migrate` (falls back to DB_ADMIN_*, then the app user)
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
# Development only: admin connection used by local tooling
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_ADMIN_NAME=
# Payments (not in use yet)
PAYMENT_DB_USER=
PAYMENT_DB_PASSWORD=
PAYMENT_DB_NAME=

# ── Redis (queues, cache) ───────────────────────────────────────────────────
REDIS_HOST=127.0.0.1                 # or REDIS_URL=redis://... / rediss://...
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
REDIS_USE_TLS=                       # true for TLS (auto-detected for ElastiCache / port 6380)
REDIS_TLS_REJECT_UNAUTHORIZED=       # true to verify the Redis TLS certificate
REDIS_IS_CLUSTER=                    # true | false (auto-detected from the host name)

# ── File storage (S3) ───────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=                    # leave empty to use the EC2 instance role
S3_SECRET_ACCESS_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=MANO Attendance
# Gmail API (alternative to SMTP)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ADMIN_EMAIL=                         # comma separated; receives feedback notifications

# ── Push notifications (Firebase) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                # keep the \n line breaks, in double quotes
FIREBASE_SERVICE_ACCOUNT_PATH=       # alternative: path to the service account JSON

# ── AI / maps ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
MAP_API_KEY=                         # Google Maps geocoding
WEBSITE_CHAT_CHROMA_URL=http://localhost:8000
WEBSITE_CHAT_COLLECTION=
WEBSITE_CHAT_CHUNKS_FILE=
WEBSITE_CHAT_TOP_K=
WEBSITE_CHAT_DEBUG=

# ── Payments (Razorpay, not in use yet) ─────────────────────────────────────
RAZORPAY_KEY_ID=                     # (required) the client is created at startup; any value works while unused
RAZORPAY_KEY_SECRET=                 # (required)
RAZORPAY_WEBHOOK_SECRET=

# ── PM2 log viewer (super admin) ────────────────────────────────────────────
PM2_OUT_LOG_PATH=                    # e.g. /root/.pm2/logs/MANO-Attendance-out.log
PM2_ERR_LOG_PATH=                    # e.g. /root/.pm2/logs/MANO-Attendance-error.log
